{
  "_doc": "Copy and adapt: mf new <id> --repo <repo> --from /opt/myflow/templates/task.example.json. Keys starting with _ are ignored. Template vars in commands/env: {wt} worktree, {lane} {task} {run} per-invocation dir, {gpu} {seed} {lane_dir} private dir (cache/, tmp/) {task_dir} {repo} {base}.",
  "title": "QSA union fp8 prefill speedup",
  "goal": "m12000 kv_slots TP2 fp8_tensor: union+direct kernel time -20% without breaking op_test",
  "metric": {
    "name": "latency_us",
    "direction": "min",
    "aggregate": "geomean",
    "target": 1.25,
    "min_improve": 0.02,
    "weights": {}
  },
  "commands": {
    "_doc": "Commands run with cwd={wt} via bash -c. bench must print one line per case: MF_METRIC case=<name> value=<number>. correctness: exit 0 = pass.",
    "setup": "",
    "correctness": "PYTHONPATH={wt} /opt/lc/work/qsa-fp8/venv-fly050/bin/python -m pytest -q -x op_tests/test_flydsl_qsa_sparse_prefill.py",
    "bench": "PYTHONPATH={wt} /opt/lc/work/qsa-fp8/venv-fly050/bin/python {task_dir}/tools/bench_qsa.py --jobs m12000_slots_tp2,m12000_slots_tp4",
    "bench_quick": "",
    "verify_extra": "",
    "gate": ""
  },
  "parse": {
    "mode": "mf"
  },
  "env": {
    "FLYDSL_RUNTIME_CACHE_DIR": "{lane_dir}/cache/flydsl",
    "TMPDIR": "{lane_dir}/tmp"
  },
  "scope": {
    "allow": [
      "aiter/ops/flydsl/**"
    ],
    "protect": [
      "op_tests/test_flydsl_qsa_sparse_prefill.py"
    ],
    "ignore": []
  },
  "gpu": {
    "pool": "0-7",
    "max_use": 5,
    "max_vram": 20,
    "gate": "strict",
    "env": "HIP_VISIBLE_DEVICES",
    "wait_s": 3600
  },
  "budget": {
    "max_attempts": 40,
    "max_hours": 24,
    "max_no_improve": 10,
    "max_fail_streak": 4,
    "heartbeat_min": 30,
    "timeout_s": 1800
  },
  "freeze": {
    "repeats": 3
  },
  "verify": {
    "pairs": 4,
    "clean": "fd",
    "max_case_regress": 0.02
  },
  "gates": {
    "spec": "ask",
    "plan": "ask",
    "integrate": "notify",
    "report": "notify"
  },
  "survey": {
    "repos": [
      "/opt/aiter",
      "/opt/lc/FlyDSL",
      "/opt/lc/pyhip"
    ]
  },
  "_milestones": "docs/DESIGN-v2-milestones.md: git.url is pinned by the user's first push approval; doc/tests paths are what the closing roles may change.",
  "git": {
    "url": "",
    "branch": "",
    "push": "first-ask",
    "lang": "en"
  },
  "doc": {
    "entry": "",
    "paths": [],
    "lang": "zh",
    "max_lines": 250
  },
  "tests": {
    "paths": [
      "op_tests/test_flydsl_qsa_sparse_prefill.py"
    ]
  },
  "milestone": {
    "max_lines": 800,
    "max_hours": 24
  }
}
